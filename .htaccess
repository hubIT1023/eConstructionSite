<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # -------------------------------------------------------------
    # 1. Block AI Scrapers & ChatGPT Crawlers (Immediate 403 Forbidden)
    # -------------------------------------------------------------
    RewriteCond %{HTTP_USER_AGENT} (GPTBot|ChatGPT-User|OAI-SearchBot|CCBot|ClaudeBot|anthropic-ai|PerplexityBot|Bytespider|Applebot-Extended|Amazonbot) [NC]
    RewriteRule ^.*$ - [F,L]

    # -------------------------------------------------------------
    # 2. Existing System Routing (Preserved Exactly)
    # -------------------------------------------------------------
    # Case-insensitive route: /WebPOS, /webpos, /WEBPOS -> webpos.php
    RewriteRule ^webpos/?$ webpos.php [NC,L,QSA]

    # Soft Rewrite: Internally route clean extensionless URLs to their corresponding .php files
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^(.*)$ $1.php [L,QSA]
</IfModule>
