# ==============================================================================
# eConstruction Supply - Production-Safe .gitignore
# ==============================================================================

# Environment & Secrets (NEVER commit real credentials)
.env
.env.*
*.env
!.env.example
!.env*.example
*.pem
ssl/dev/
!ssl/.gitkeep

# Application Logs & Runtime Files
*.log
emails.log
deployments.log

# Diagnostics, Transcripts & Development Scratch
scratch/
transcript*.jsonl
local_*.txt
droplet_*.txt
*.xlsx
*.csv

# Archive, Backup & Dump Files
*.tar.gz
*.sql.gz
*.bak
*.bak_*
*.dump
*.backup
backups/

# Vendor & Node Dependencies
/vendor/
node_modules/

# Temporary & Cache Directories
/cache/
/tmp/
caddy_data/
caddy_config/

# IDE & OS Generated Files
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
.DS_Store
Thumbs.db
