# ==============================================================================
# eConstruction Supply - Production-Safe .gitignore
# ==============================================================================

# Environment & Secrets (NEVER commit real credentials)
.env
.env.*
*.env

# Application Logs & Runtime Files
*.log
emails.log
deployments.log

# Diagnostics, Transcripts & Development Scratch
scratch/
transcript*.jsonl
local_*.txt
droplet_*.txt

# Archive, Backup & Dump Files
*.tar.gz
*.sql.gz
*.bak
*.backup
backups/

# Vendor Dependencies (if Composer is added later)
/vendor/

# Temporary & Cache Directories
/cache/
/tmp/
caddy_data/
caddy_config/

# IDE & OS Generated Files
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
.DS_Store
Thumbs.db
