<style>
body { font-family: Calibri, Arial, sans-serif; font-size: 11pt; }
table { border-collapse: collapse; width: 100%; }
th { background-color: #0284c7; color: #ffffff; font-weight: bold; border: 1px solid #0369a1; padding: 8px 10px; text-align: center; }
td { border: 1px solid #cbd5e1; padding: 6px 10px; vertical-align: middle; }
.num { mso-number-format:"\#\,\#\#0\.00"; text-align: right; }
.int { mso-number-format:"\#\,\#\#0"; text-align: right; }
.center { text-align: center; }
.zebra { background-color: #f8fafc; }
.alert-red { background-color: #fee2e2; color: #dc2626; font-weight: bold; text-align: center; }
.alert-orange { background-color: #ffedd5; color: #ea580c; font-weight: bold; text-align: center; }
.alert-green { background-color: #dcfce7; color: #16a34a; font-weight: bold; text-align: center; }
</style>
</head>
